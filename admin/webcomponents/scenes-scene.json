                    "en": "PIN",
                    "de": "PIN",
                    "ru": "PIN-код",
                    "pt": "PIN",
                    "nl": "Pincode",
                    "fr": "Code PIN",
                    "it": "PIN",
                    "es": "PIN",
                    "pl": "PIN",
                    "uk": "PIN-код",
                    "zh-cn": "PIN 码"
